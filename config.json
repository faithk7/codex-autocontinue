{
    "phrase": "model is at capacity",
    "reply": "continue",
    "poll_interval_seconds": 0.25,
    "response_delay_seconds": 1.0,
    "skip_when_queued": true,
    "per_thread_cooldown_seconds": 60,
    "max_continues_per_hour": 20,
    "dry_run": false,
    "desktop_app_name": "ChatGPT",
    "inject_cli": true,
    "inject_app": true,
    "use_tmux": true,
    "use_applescript": true,
    "use_xdotool": true,
    "use_ydotool": true
}
